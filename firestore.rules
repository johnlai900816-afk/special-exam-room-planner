rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email; }
    function access() { return get(/databases/$(database)/documents/config/access).data; }

    // 共用名單：第一位登入者成為管理者，之後只有管理者能改
    match /config/access {
      allow get: if signedIn() && (resource == null || email() in resource.data.emails);
      allow create: if signedIn() && request.resource.data.admin == email() && request.resource.data.emails == [email()];
      allow update: if signedIn() && resource.data.admin == email() && request.resource.data.admin == email() && email() in request.resource.data.emails;
    }
    // 考場資料：只有共用名單內的帳號可讀寫
    match /exams/{id} {
      allow read, write: if signedIn() && email() in access().emails;
    }
  }
}
