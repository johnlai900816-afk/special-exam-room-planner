{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/flat-prefetch.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --config firebase.emulator.json --only firestore --project demo-rc \"vitest run test/rules\"",
    "test:e2e": "firebase emulators:exec --config firebase.emulator.json --only firestore,auth --project demo-rc \"vitest run --no-file-parallelism test/e2e\""
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
